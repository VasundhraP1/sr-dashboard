{
  "name": "Steady Rabbit Requirement Console Backend",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "google-login",
        "options": {}
      },
      "id": "e2f6b8b0-a396-48be-8f0a-a0353c7a0201",
      "name": "Webhook: Google Login",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const token = $input.item.json.body.credential;\nif (!token) {\n  return { json: { success: false, message: 'No credential provided' } };\n}\n\ntry {\n  const parts = token.split('.');\n  if (parts.length !== 3) {\n    return { json: { success: false, message: 'Invalid token format' } };\n  }\n  const payload = JSON.parse(Buffer.from(parts[1], 'base64').toString('utf-8'));\n  \n  const email = (payload.email || '').toLowerCase();\n  const name = payload.name || 'User';\n  \n  let role = 'HR';\n  // Check if Vasundhra or custom marketing emails\n  if (email === 'vasundhara@steadyrabbit.in' || name.toLowerCase().includes('vasundh') || name.toLowerCase().includes('admin')) {\n    role = 'Both';\n  } else if (email.startsWith('marketing') || name.toLowerCase().includes('marketing')) {\n    role = 'Marketing';\n  }\n  \n  return {\n    json: {\n      success: true,\n      name: name,\n      email: email,\n      picture: payload.picture || '',\n      role: role\n    }\n  };\n} catch (e) {\n  return { json: { success: false, message: 'Error decoding token: ' + e.message } };\n}"
      },
      "id": "9dcd7531-bc6a-4934-be5c-43f7a1f592d3",
      "name": "JS: Decode Google Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        100
      ]
    },
    {
      "parameters": {
        "options": {
          "responseCode": "= {{$json.success ? 200 : 401}}"
        }
      },
      "id": "f51b9e24-9b98-4c81-807d-304b7e1ea7df",
      "name": "Respond: Login Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        540,
        100
      ]
    },
