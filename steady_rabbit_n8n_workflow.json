        "jsCode": "const body = $input.item.json.body;\nconst requirement_name = body.requirement_name;\nconst added_by = body.added_by;\nconst candidatesList = body.candidates || [];\n\nconst formatted = candidatesList.map(c => ({\n  json: {\n    'Date': new Date().toISOString().split('T')[0],\n    'Requirement Name': requirement_name,\n    'Candidate Name': c.name,\n    'Resume Link': c.resume_link,\n    'Notice Period': c.notice_period || '—',\n    'CTC': c.ctc || '—',\n    'Remarks': c.remarks || '—',\n    'Submitted By': added_by\n  }\n}));\n\nreturn formatted;"
