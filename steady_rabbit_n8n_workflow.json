        "jsCode": "const items = $input.all();\nconst requirements = items.map(item => ({\n  date: item.json['Date'] || '',\n  requirement: item.json['Requirement'] || '',\n  priority: item.json['Priority'] || '',\n  assignee: item.json['Assignee'] || '',\n  requirement_owner: item.json['Requirement Owner'] || '',\n  vendor_budget: item.json['Vendor Budget'] || '',\n  client_budget: item.json['Client Budget'] || '',\n  location: item.json['Location'] || '',\n  client_name: item.json['Client Name'] || '',\n  poc: item.json['POC'] || '',\n  entity: item.json['Entity'] || '',\n  status: item.json['Status'] || 'Inactive',\n  contract_type: item.json['Type of Contract'] || '',\n  shift_timings: item.json['Shift Timings'] || '',\n  hyd_telangana: item.json['Hyd/Telangana'] || '',\n  candidate_name: item.json['Candidate'] || '—'\n}));\n\nreturn { json: { success: true, requirements } };"
      },
